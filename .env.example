# Copy to .env for docker compose. Never commit .env.
POSTGRES_USER=analysisace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=analysisace
DATABASE_URL=postgresql+psycopg://analysisace:change-me@db:5432/analysisace
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
# URL the Next.js server uses to reach the API inside the compose network
API_INTERNAL_URL=http://api:8000

# Outgoing email (docs/DECISIONS.md, D24). "log" writes messages to the API and worker log.
# For real delivery set EMAIL_BACKEND=smtp and the SMTP_* values from your provider,
# for example Amazon SES (email-smtp.<region>.amazonaws.com), Postmark (smtp.postmarkapp.com),
# SendGrid (smtp.sendgrid.net), Mailgun (smtp.mailgun.org) or Resend (smtp.resend.com).
EMAIL_BACKEND=log
EMAIL_FROM=analysisACE <no-reply@analysisace.com>
EMAIL_REPLY_TO=
# Hours a sign-up confirmation link stays valid (D25)
EMAIL_VERIFICATION_TTL_HOURS=48
WEB_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Browser push (D26). Generate with: backend/.venv/Scripts/python backend/scripts/generate_vapid_keys.py
# Leave empty to keep push off. Keep the private key secret.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:support@analysisace.com
# Comma-separated addresses told when a scheduled job fails
OPS_ALERT_EMAILS=
